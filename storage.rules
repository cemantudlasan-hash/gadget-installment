rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Public read access for all files
    match /{allPaths=**} {
      allow read;
    }

    // Allow anonymous writes ONLY to the thumbnails directory for the AI flow.
    match /thumbnails/{imageId} {
      allow write;
    }

    // Explicitly deny writes to other paths if not authenticated.
    // Note: This rule isn't strictly necessary if the `thumbnails` rule is the only write-allow rule,
    // but it makes the security posture more explicit.
    match /{path=**} {
      allow write: if request.auth != null;
    }
  }
}
